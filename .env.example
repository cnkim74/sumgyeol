# ─── 숨결 환경 변수 ──────────────────────────────────
# 실제 값은 .env.local 에 두세요. .env.local 은 gitignore 됩니다.

# iron-session 쿠키 암호화 키 — 32자 이상 무작위 문자열 필수.
# 생성: `openssl rand -hex 32`
SESSION_PASSWORD=replace-with-32-or-more-random-chars-from-openssl-rand-hex-32

# 데이터베이스 — 비워두면 로컬 SQLite (data/sumgyeol.db).
# 프로덕션은 Turso 같은 libsql 호스팅 권장.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...

# 관리자 자동 승격 — 콤마로 여러 개 가능.
# 여기 적힌 이메일로 회원가입하거나 로그인하면 즉시 admin 등급이 됨.
# 가입 시 받는 등급(member/funeral/park) 이 무엇이든 admin 으로 바뀜.
# ADMIN_EMAILS=cnkim@example.com,founder@sumgyeol.kr
